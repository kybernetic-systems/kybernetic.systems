{
	"$schema": "node_modules/wrangler/config-schema.json",
	// The company site, served from `dist/site` as static assets with no Worker script. Asset
	// requests never invoke a Worker, so none of the request or CPU limits apply to them.
	//
	// `routes` attaches the apex domain, which requires the zone to already exist in this
	// Cloudflare account: move the domain's nameservers first, or the deploy fails here.
	"name": "kybernetic-systems",
	// The newest date the `workerd` shipped with the pinned wrangler accepts; a later one makes
	// `vp run preview` refuse to start. An assets-only Worker runs no script for this to gate, so
	// it only needs to stay in step with the runtime that serves the preview.
	"compatibility_date": "2026-10-30",
	"assets": {
		"directory": "./dist/site",
		// The site links to `/about`, never `/about/`. The default `auto-trailing-slash` would
		// serve both and canonicalize to the slash, against the choice the prerender config makes.
		"html_handling": "drop-trailing-slash",
		"not_found_handling": "404-page",
	},
	"routes": [{ "pattern": "kybernetic.systems", "custom_domain": true }],
	// The site has one address. A `workers.dev` or preview copy would be a second one serving the
	// same pages, which search engines are free to index in place of the real thing.
	"workers_dev": false,
	"preview_urls": false,
}
