{
	"name": "kybernetic.systems",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": [
			"./src/*"
		],
		"#content/*": [
			"./content/*"
		],
		"#content-collections": [
			"./vite-plugins/.content-collections/generated"
		],
		"#scripts/*": [
			"./scripts/*"
		],
		"#storybook/*": [
			"./.storybook/*"
		]
	},
	"scripts": {
		"build-storybook": "storybook build",
		"content:status": "node scripts/content-status.ts",
		"deploy": "vp build && vp run hosts && vp run deploy:site && vp run deploy:mangrove",
		"deploy:mangrove": "wrangler deploy -c wrangler.mangrove.jsonc",
		"deploy:site": "wrangler deploy -c wrangler.site.jsonc",
		"githooks:install": "git config core.hooksPath .githooks",
		"hosts": "node scripts/hosts.ts",
		"og": "node scripts/og.ts",
		"preview": "wrangler dev -c wrangler.site.jsonc",
		"preview:mangrove": "wrangler dev -c wrangler.mangrove.jsonc",
		"storybook": "storybook dev -p 6006"
	},
	"dependencies": {
		"@fontsource-variable/eb-garamond": "^5.3.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@tanstack/react-devtools": "^0.10.13",
