		"@tanstack/react-router-devtools": "^1.167.2",
		"@tanstack/react-start": "^1.168.60",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^5.3.1",
		"@content-collections/core": "^0.15.3",
		"@content-collections/vite": "^0.3.1",
		"@fontsource/eb-garamond": "^5.3.0",
		"@realfavicongenerator/generate-favicon": "0.9.0",
		"@realfavicongenerator/image-adapter-node": "0.9.0",
		"@resvg/resvg-js": "^2.6.2",
		"@rolldown/plugin-babel": "^0.2.4",
		"@storybook/addon-a11y": "^10.6.1",
		"@storybook/addon-docs": "^10.6.1",
		"@storybook/addon-mcp": "^10.6.1",
